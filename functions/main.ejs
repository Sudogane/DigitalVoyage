<script>  
  const API = axios.create({
    baseURL: `${window.location.origin}/api` 
  })
  
  let previousMarqueeData = {}
  
  function setLiveNewsData() {
      const liveNews = document.getElementById("livenews_marquee")
      //liveNews.innerHTML = "Disabled until futher notice"
      //return
    
      setInterval(() => {
        API.get("livenews").then(({ data }) => {
          if(data[2] && previousMarqueeData[2] && previousMarqueeData[2].title === data[2].title && previousMarqueeData[2].content === data[2].content) return
          previousMarqueeData = data 

          let liveNewsContents = data.map((news, index) => ` <span class="xm-line-item" style="white-space: nowrap;"><span style="color: #fff">${news.title}</span> ${news.content} ${(data[index + 1]) ? '<span class="separator"><span class="separator-bar">/</span><span class="separator-bar">/</span></span> ' : ""}</span>`).join("")

          liveNews.innerHTML = liveNewsContents
        })
      }, 1000)
  }
  
  setLiveNewsData()
  
  function openMobileMenu() {
    swal.fire(
      {
        showConfirmButton: false,
        allowOutsideClick: true,
        html: `
                <div class="section-title-wrap blue" style="margin-bottom: 24px; margin-top: 8px; text-align: left;">
                  <div class="ui-icon-wrap">
                    <img class="ui-icon-30" style="margin-right: 8px;" src="https://ik.imagekit.io/projectvoyage/Interface/ui_digimon_0HF4BIuFA.png?ik-sdk-version=javascript-1.4.3&updatedAt=1670783679134">
                    <div>
                      <h2 class="section-title">Digimon Voyage</h2>
                      <h4 class="section-subtitle">Main Menu</h4>
                    </div>
                  </div>
                  <div class="section-title-separator"></div>
                </div>
          
          <div class="mobileversion-menu-wrapper">
            <a class="mobileversion-menu-item" href="/">
              <img class="ui-icon-60" src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_myHome.png?v=1665342182400">
              <h4 style="margin-top: 11px;">Home</h4>
            </a>
          
            <% if(!locals.userData) { %>
            <a class="mobileversion-menu-item" href="/login">
              <img class="ui-icon-60" src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_demiVeemon.png?v=1665342070850">
              <h4>Login</h4>
            </a>
            <% } else { %>
              <%- include("../partials/tamer/mobile/menuContents") %>
            <% } %>
          </div>
        `
      }
    )
  }
</script>

<% if(locals.userData) { %>
<script>
  <% if(userData.modules.stamina.current < userData.modules.stamina.max) { %>
    const untilNextStaminaRegen = document.getElementById("user_sidebar_nextStaminaRegen")
    const untilFullStaminaRegen = document.getElementById("user_sidebar_untilFullStamina")
    
    let MS_NextStaminaRegen = <%- staminaRegen.next %>;
    let NextStaminaRegenCounter = setInterval(NextStaminaRegenTimer, 1000);

    function NextStaminaRegenTimer() {
      if (MS_NextStaminaRegen <= 0) {
        clearInterval(NextStaminaRegenCounter);
        return;
      }

      let minutes = Math.floor((MS_NextStaminaRegen % (1000 * 60 * 60)) / (1000 * 60));
      let seconds = Math.floor((MS_NextStaminaRegen % (1000 * 60)) / 1000);

      untilNextStaminaRegen.innerHTML = `${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
      MS_NextStaminaRegen -= 1000;
    }
                                                                          
    let MS_FullStaminaRegen = <%- staminaRegen.full %>;
    let FullStaminaRegenCounter = setInterval(FullStaminaRegenTimer, 1000);

    function FullStaminaRegenTimer() {
      if (MS_FullStaminaRegen <= 0) {
        clearInterval(FullStaminaRegenCounter);
        return;
      }

      let hours = Math.floor((MS_FullStaminaRegen % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      let minutes = Math.floor((MS_FullStaminaRegen % (1000 * 60 * 60)) / (1000 * 60));
      let seconds = Math.floor((MS_FullStaminaRegen % (1000 * 60)) / 1000);

      untilFullStaminaRegen.innerHTML = `${hours < 10 ? '0' : ''}${hours}:${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
      MS_FullStaminaRegen -= 1000;
    }
                                                                                                                                    
  <% } %>
  <% for(digimon of userData.modules.party) { %>
  tippy("#party-box-<%- digimon._id %>", {
    theme: "maintheme",
    content: `
      <div style="width: 240px">
                  <div style="display: flex; justify-content: center; background: url('https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/dazhaodi.jpg?v=1665511760826'); background-size: cover; background-position: center; height: 180px; border-radius: 0 16px 0 0;">
                    <img style="max-height: 80%; align-self: center;" src="<%- digimon.sprite %>">
                  </div>
                  
                  <div class="TT-evolution">
                    <div style="margin-bottom: 16px; text-align: center;">
                      <h3><%- digimon.nickname || digimon.species %></h3>
                      <%- (digimon.nickname && digimon.nickname.toLowerCase() !== digimon.species.toLowerCase()) ? `<p>${digimon.species}</p>` : "" %>
                    </div>
                    
                    <div style="text-align: center; display: flex; justify-content: center; gap: 8px;">
                      <h4>Level: <p style="display: inline;"> <%- digimon.level%></p><h4>
                      <% 
                        let additionalBaseExpNeeded = {
                          "In-Training": 36,
                          "Rookie": 50,
                          "Champion": 76,
                          "Ultimate": 120,
                          "Mega": 160
                        }
                        let formExpMultiplier = {
                          "In-Training": 0.95,
                          "Rookie": 1.2,
                          "Champion": 1.6,
                          "Ultimate": 2.4,
                          "Mega": 2.98
                        }
                        let tierExpMultiplier = 1
                               
                        let toLevelUp = Math.floor( ( additionalBaseExpNeeded[digimon.form] * (digimon.level * 0.868) ) * 2.35 )
                        toLevelUp = Math.floor( toLevelUp * formExpMultiplier[digimon.form] )
                      %>
                      <h4>EXP: <p style="display: inline;"> <%- digimon.xp%>/<%- toLevelUp %></p><h4>
                    </div>
                    
                    <div class="party-modal-stats">
                      <p><b>Health:</b> <%- digimon.stats.health + digimon.stats.additional.health %> <b>Mana:</b> <%- digimon.stats.mana + digimon.stats.additional.mana %></p>
                      <p><b>Attack:</b> <%- digimon.stats.attack + digimon.stats.additional.attack %> <b>Defense:</b> <%- digimon.stats.defense + digimon.stats.additional.defense %></p>
                      <p><b>Speed:</b> <%- digimon.stats.speed + digimon.stats.additional.speed %></p>
                    </div>
      </div>
    `,
    allowHTML: true,
    interactive: true
  })
  <% } %>
  
  
  function mobileOpenPartyModal() {
    swal.fire(
      {
        showConfirmButton: false,
        allowOutsideClick: true,
        width: "440px",
        showClass: {
          popup: 'animate__animated animate__fadeIn animate__faster'
        },
        hideClass: {
          popup: 'animate__animated animate__fadeOut animate__faster'
        },
        willOpen: (arg) => {
          function createPartyHealthbar(index, health) {
            let healthbar = document.getElementById("mobile-party-healthbar"+index)
            healthbar = new ProgressBar.Line(healthbar, {
              strokeWidth: 5,
              easing: "easeInOut",
              duration: 1400,
              color: "#58d819",
              trailColor: "#eee",
              trailWidth: 1,
              svgStyle: { width: "50%", height: "50%" },
              path: {
                style: {
                  strokeLinecap: "round"
                }
              }
            })
            
            healthbar.set(health)
          }
          
          function createPartyExpProgressbar(index, exp) {
            let expbar = document.getElementById("mobile-party-expbar"+index)
            if(exp > 1) exp = 1
            
            expbar = new ProgressBar.Line(expbar, {
              strokeWidth: 5,
              easing: "easeInOut",
              duration: 1400,
              color: "#d8c519",
              trailColor: "#eee",
              trailWidth: 1,
              svgStyle: { width: "50%", height: "50%" },
              path: {
                style: {
                  strokeLinecap: "round"
                }
              }
            })
            
            expbar.set(exp)
          }
          
          <% if(typeof userData.modules.party !== 'undefined' && userData.modules.party.length !== 0) { %>
            <% userData.modules.party.forEach((digimon, index) => { %>
              <% 
                  let additionalBaseExpNeeded = {
                    "In-Training": 36,
                    "Rookie": 50,
                    "Champion": 76,
                    "Ultimate": 120,
                    "Mega": 160
                  }
                  let formExpMultiplier = {
                    "In-Training": 0.95,
                    "Rookie": 1.2,
                    "Champion": 1.6,
                    "Ultimate": 2.4,
                    "Mega": 2.98
                  }
                  let tierExpMultiplier = 1

                  let toLevelUp = Math.floor( ( additionalBaseExpNeeded[digimon.form] * (digimon.level * 0.868) ) * 2.35 )
                  toLevelUp = Math.floor( toLevelUp * formExpMultiplier[digimon.form] )
              %>
              createPartyHealthbar(<%- index %>, <%- (digimon.health/( 2 * (digimon.stats.health+digimon.stats.additional.health) ) / 1.0)%>)
              createPartyExpProgressbar(<%- index %>, <%- (digimon.xp/toLevelUp) * 1.0 %>)
            <% })%>
          <% } %>
        },
        html: `
          <div class="mobileversion-partywrapper">
					<% if (userData.newAccount === 3 && userData.modules.party.length !== 0) {%>
							<!-- SECTION TITLE WRAP -->
							<div class="section-title-wrap green" style="text-align: left; margin-bottom: 16px;">
								<h2 class="section-title medium">
									<img src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_myTeam.png?v=1665342182620"> My Team
								  
                  <%
                    let PartyPower = 0;  
                    
                    for(var i=0; i< userData.modules.party.length; i++) {
                      const thisMon = userData.modules.party[i]
                      Object.keys(thisMon.stats).forEach(stat => {
                        if(stat === "additional") return
                        PartyPower += thisMon.stats[stat] + thisMon.stats.additional[stat]
                      })
                    }
                  
                    PartyPower = Math.floor(PartyPower / 8.5)
                  %>
                    
                  <div style="text-align: right; float: right; margin-top: 5px;"><%- PartyPower %> PP</div>
                </h2>
								<div class="section-title-separator"></div>
							</div>
							<!-- /SECTION TITLE WRAP -->
              
							<!--  MY TEAM PREVIEW -->
							<div class="inventory-items-preview mobile-party">
                <% for (var i=0; i < 3;  i++ ) { %>
                  <% if(userData.modules.party[i]) { %>
                    <!-- MY TEAM DIGIMON PREVIEW -->
                    <div class="inventory-item-preview">
                      <!-- DIGIMON PREVIEW -->
                      <div class="product-preview small" style="box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;">
                        <!-- DIGIMON PREVIEW IMG WRAP -->
                        <div class="product-preview-img-wrap">
                          <!-- DIGIMON PREVIEW IMG -->
                          <a href="/digibank/<%- userData.modules.party[i]._id %>">
                            <figure class="product-preview-img box_digimon <%- (userData.modules.party[i].health === 0) ? 'battle-defeated' : ''%>">
                              <img style="width: fit-content; max-width: 82px; max-height: 82px;" src="<%- userData.modules.party[i].sprite %>" alt="<%- userData.modules.party[i].species %>">
                            </figure>
                          </a>
                          <!-- /DIGIMON PREVIEW IMG -->
                        </div>
                        <!-- /DIGIMON PREVIEW IMG WRAP -->
                      </div>
                      <!-- /DIGIMON PREVIEW -->
                      <div class="party-progressbar"><div id="mobile-party-healthbar<%- i %>"></div></div>
                      <div class="party-progressbar" style="margin-top: -8px;"><div id="mobile-party-expbar<%- i %>"></div></div>
                    </div>
                    <!-- /MY TEAM DIGIMON PREVIEW -->
                  <% } else { %>
                    <!-- MY TEAM DIGIMON PREVIEW -->
                    <div class="inventory-item-preview empty party-preview" style="box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;">
                      <!-- NO DIGIMON ICON -->
                      <div class="party-preview-nodigimon"></div>
                      <!-- /NO DIGIMON ICON -->
                    </div>
                    <!-- /MY TEAM DIGIMON PREVIEW -->
                  <% } %>
                <% } %>
							</div>
							<!-- /MY TEAM PREVIEW -->
                    
              <%
                let _lowHealthFilter = userData.modules.party.filter((digimon) => (digimon.health/ ( 2* (digimon.stats.health + digimon.stats.additional.health) ) * 100) <= 90)
                if(_lowHealthFilter?.[0]) {
              %>
                <div class="lowhealth-warning" style="margin-top: 8px;">
                  <% if(locals.STAGE) { %>
                    <p style="text-align: center;">Your partners are low on health, but you can't go to the hospital right now.</p>
                  <% } else { %>
                    <p style="text-align: center;">Your Digimon are low on health, <a onclick="_openHospital()"><strong>click here</strong></a> to go to the hospital!</p>
                  <% } %>
                </div>
              <% } %>
					<% } %>
        </div>
        `
      }
    )
  }
  
  <% if(!locals.STAGE) { %>
  function _openHospital() {
    Swal.fire({
    padding: "0px",
    title: `<h3 class="section-title small" style="text-align: left; text-transform: inherit;"><img class="ui-icon-30" src="https://ik.imagekit.io/projectvoyage/Interface/ui_hospital_ycjrd1eAY.png?ik-sdk-version=javascript-1.4.3&updatedAt=1670297293156"> Centarumon's Hospital</h3><div class="section-title-separator"></div>`,
    customClass: {
      title: "section-title-wrap blue"
    },
    allowOutsideClick: true,
    allowEscapeKey: true,
    showConfirmButton: false,
    html: `
      <div class="hospital-modal">
        <img style="max-width: 30%; position: absolute; top: 22%; right: 1%; width: 130px;" src="https://static.wikia.nocookie.net/digimon/images/1/12/Centarumon_vg.gif"></img>
        <div class="bubble mobile-dialogue-hospital" style="margin-top: 90px; padding: 8px;"> <p>Welcome, <strong><%- (locals.userData) ? userData.username : "Placeholder" %></strong> to my Hospital.<br>Here, you can heal your digimon, but in order to heal them i'll have to charge you a few Bits.<br>Price: <strong><span class="icon-bits" style="margin-left: 2px;"></span>5 Bits</strong></p></div>
        <button class="button blue button-normal" onclick="_hospitalHeal()" style="margin-top: 16px;">Heal Digimon</button>
      </div>
    `
    })
  }
  
  function _hospitalHeal() {
    API.get("/hospital/heal").then(({ data }) => {
      if(data.success) window.location.reload()
      if(data.lowOnBits) alert("tu é pobre mano.")
    })
  }
    
  function _openAvatarModal() {
    Swal.fire({
      title: `<h3 class="section-title small" style="text-align: left; text-transform: inherit;"><img class="ui-icon-30" src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_tamer.png?v=1665342182399"> My Avatar</h3><div class="section-title-separator"></div>`,
      customClass: {
        title: "section-title-wrap blue"
      },
      allowOutsideClick: true,
      allowEscapeKey: true,
      showConfirmButton: false,
      html: `
        <div style="height: max-content; padding: 16px;">
          <img style="box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;border-radius: 8px;" width=254 height=254 src="<%- (userData && userData?.avatarUrl) ? userData?.avatarUrl : costume?.avatarUrl %>"></img>
          <p style="margin-top: 1rem;"><b class="text-white">Change Avatar</b></p>

          <form id="_uploadAvatar" enctype="multipart/form-data">
              <input type="file" style="margin-top: 1rem" name="image" accept="image/*"/>
              <button class="button blue button-normal" type="submit" style="margin-top: 32px;"><i class="fa-solid fa-turn-up" style="transform: scaleX(-1);"></i> Upload Avatar</button>
          </form>
        </div>
      `,
      willOpen: () => {
        const avatarUploadForm = document.getElementById("_uploadAvatar")
        avatarUploadForm.addEventListener('submit', async (event) => {
          event.preventDefault()
          const formData = new FormData(avatarUploadForm)
          
          API.post("/avatar", formData, { headers: { 'Content-Type': 'multipart/form-data' } }).then(({ data }) => {
            //console.log(data)
            if(data.success) return window.location.reload()
          })
        })
      }
    })
  }

  function _upgradeDigivice() {
    API.get("/upgrade/digivice").then(({ data }) => {
      if(data.success) window.location.reload()
    })
  }
                        
  function _openDigiviceLevelModal() {
    
    <%
      const tamerRankRequiredDigivices = {
        2: 3,
        3: 5
      }
    %>
    
    Swal.fire({
      title: `<h3 class="section-title small" style="text-align: left; text-transform: inherit;"><img class="ui-icon-30" src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_tamer.png?v=1665342182399"> Digivice Level</h3><div class="section-title-separator"></div>`,
      customClass: {
        title: "section-title-wrap blue"
      },
      allowOutsideClick: true,
      allowEscapeKey: true,
      showConfirmButton: false,
      html: `
        <div style="height: max-content; padding: 16px;">
          <img style="width: 100px; margin-top: 4px;" class="floater" src="https://ik.imagekit.io/projectvoyage/Interface/Digivices/DigiviceBasico_NkxA3Pec40.png?updatedAt=1679421663299"></img>
          <div class="upgrade-info-container">
            <p><b class="text-white">Current Level:</b> <%- userData.modules.levels.digivice %></p>
            <p><b class="text-white">Scan Amount:</b> <%- digivice.minScan %>% - <%- digivice.maxScan%>%</p>
            <p><b class="text-white">Stamina Cost:</b> 5 per Scan
            <% if(digivice.requirementsToUpgrade) { %>
              <br>
              <br>
              <p><b class="text-white">Requirements for next Level:</b>
                <br>
                <%- (digivice.requirementsToUpgrade.bits ) ? `${digivice.requirementsToUpgrade.bits} Bits` : ""%>
                <br>
                <%- (tamerRankRequiredDigivices[userData.modules.levels.digivice + 1]) ? `Tamer Rank ${tamerRankRequiredDigivices[userData.modules.levels.digivice + 1]}` : "" %>
                <br>
              </p>
            <% } %>
          </div>
          <button class="button blue button-normal <%- (typeof digivice.requirementsToUpgrade === "undefined" || digivice.requirementsToUpgrade.bits > userData.modules.BITS || userData.modules.level < tamerRankRequiredDigivices[userData.modules.levels.digivice + 1]) ? "disabled" : "" %>" onclick="_upgradeDigivice()" style="margin-top: 32px;"><i class="fa-solid fa-turn-up" style="transform: scaleX(-1);"></i>  Upgrade Digivice</button>
        </div>
      `
    })
  }
                   
  async function _getGachaBannerData() {
    try {
      const response = await API.get("/gacha/banner");
      return response.data;
    } catch (error) {
      console.error("Erro ao obter dados do Gacha:", error);
      throw error;
    }
  }
                             
  async function _pullOnBanner(amount) {
    try {
      const response = await API.post("/gacha/banner/pull", { amount })
      const { data } = response
      
      return _gachaPullAnimation(data.biggestRarity, data.items)
    } catch (error) {
      console.error("Erro ao atirar no Gacha")
      
      Toastify({
        escapeMarkup: false,
        text: `<h4>${error.response.data.error}</h4>`,
        duration: 3000,
        close: false,
        gravity: "top",
        position: "center", 
        stopOnFocus: false,
        className: "app-toast failure"
      }).showToast()  
      
      throw error
    }
  }

  function gerarEstrelas(numero) {
    let estrelas = '';

    for (let i = 0; i < numero; i++) {
      estrelas += '\u2605';
    }

    return estrelas;
  }  
                     
  function _gachaPullAnimation(rarity, items) {    
    const animation = {
      3: "https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/Evo1.gif?v=1689606774504", 
      4: "https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/Evo2.gif?v=1689606785134", 
      5: "https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/Evo%203.gif?v=1689606789218"
    }
    
    const ost = {
      3: "https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/gachaPull3.mp3?v=1689625741571",
      4: "https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/gachaPull4.mp3?v=1689625743273",
      5: "https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/gachaPull5.mp3?v=1689625742472"
    }
    
    
    const backgroundMusic = new Audio(ost[rarity])
    
    const testando = swal.mixin({
      showConfirmButton: false,
      showClass: {
        popup: "animate__animated animate__fadeIn animate__faster"
      },
      customClass: {
        htmlContainer: "swal2-html-container-full"
      },
      width: '46rem',
      padding: '0rem',
      html: `
        <div id="_gachaPullBackground" style="overflow: hidden; width: 100%; height: 26rem; background: url(${animation[rarity]}); background-size: cover; border-radius: 0 16px 0 0 !important;">
          <div id="_gachaPullContent" style="display: inline-grid; grid-template-columns: repeat(${(items.length > 1) ? 5 : 1}, 1fr); justify-content: center; align-items: center; gap: 1rem; height: 100%;"></div>
        </div>
      `,
      willOpen: () => {
        backgroundMusic.play()
      },
      didOpen: () => {
        setTimeout(() => {
          const bg = document.getElementById("_gachaPullBackground")
