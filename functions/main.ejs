                  </div>
                  <div class="section-title-separator"></div>
                </div>
                
                    <!-- TAB WRAP -->
                    <div id="_mainMenuExplore" class="tab-wrap">
                      <!-- TAB HEADER -->
                      <div class="tab-header items-6">
                        ${tabHeader}
                      </div>
                      <!-- /TAB HEADER -->

                      <!-- TAB BODY -->
                      <div class="tab-body" id="voyage-menu-body" style="height: 16rem; overflow-y: scroll; background-image: url('https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/2a35e66d-9740-457c-b441-9ed0d983c29e.image.png?v=1683047176662'); background-size: cover; background-position: center;">
                        ${tabBody}
                      </div>
                      <!-- /TAB BODY -->
                    </div>
                    <!-- /TAB WRAP -->
              `,
              showClass: {
                popup: 'animate__animated animate__fadeInDown animate__faster'
              },
              hideClass: {
                popup: 'animate__animated animate__fadeOutUp animate__faster'
              }
            })
      
            XM_Tab({
              container: '#_mainMenuExplore'
            });
    }

  <% } %>
  
  function createPartyHealthbar(index, health) {
    const healthbar = document.getElementById(`party-healthbar${index}`)
    const healthBar = new ProgressBar.Line(healthbar, {
      strokeWidth: 5,
      easing: "easeInOut",
      duration: 1400,
      color: "#58d819",
      trailColor: "#eee",
      trailWidth: 1,
      svgStyle: { width: "50%", height: "50%" },
      path: {
        style: {
          strokeLinecap: "round"
        }
      }
    })

    healthBar.set(health)
  }
                        
  function createPartyExpbar(index, health) {
    if(health > 1) health = 1
    
    const healthbar = document.getElementById(`party-expbar${index}`)
    const healthBar = new ProgressBar.Line(healthbar, {
      strokeWidth: 5,
      easing: "easeInOut",
      duration: 1400,
      color: "#d8c519",
      trailColor: "#eee",
      trailWidth: 1,
      svgStyle: { width: "50%", height: "50%" },
      path: {
        style: {
          strokeLinecap: "round"
        }
      }
    })

    healthBar.set(health) 
  }
  
  <% userData.modules.party.forEach((digimon) => { %>
    
  <% 
      let additionalBaseExpNeeded = {
        "In-Training": 36,
        "Rookie": 50,
        "Champion": 76,
        "Ultimate": 120,
        "Mega": 160
      }
      let formExpMultiplier = {
        "In-Training": 0.95,
        "Rookie": 1.2,
        "Champion": 1.6,
        "Ultimate": 2.4,
        "Mega": 2.98
      }
      let tierExpMultiplier = 1
                               
      let toLevelUp = Math.floor( ( additionalBaseExpNeeded[digimon.form] * (digimon.level * 0.868) ) * 2.35 )
      toLevelUp = Math.floor( toLevelUp * formExpMultiplier[digimon.form] )
  %>
    
    createPartyHealthbar(<%- userData.modules.party.indexOf(digimon) %>, <%- (digimon.health/(2 * (digimon.stats.health+digimon.stats.additional.health))) * 1.0%>)
    createPartyExpbar(<%- userData.modules.party.indexOf(digimon) %>, <%- (digimon.xp/toLevelUp) * 1.0 %>)

  <% }) %>
</script>
<% } %>
  
