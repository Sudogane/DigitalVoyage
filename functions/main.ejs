          </div>
        `,
          didOpen: () => {
            var millis = lastTimeDailyRedeem - Date.now();

            var hours = Math.floor(millis / 36e5),
            mins = Math.floor((millis % 36e5) / 6e4),
            secs = Math.floor((millis % 6e4) / 1000);
            document.getElementById("daily-countdown").innerHTML= `<p class="text-yellow"><b>${hours}:${mins}:${secs}</b></p>`
            
            function displaytimer(){
                var hours = Math.floor(millis / 36e5),
                    mins = Math.floor((millis % 36e5) / 6e4),
                    secs = Math.floor((millis % 6e4) / 1000);
              
                    if(hours <= 0 && mins <= 0 && secs <= 0) return window.location.reload()
                    document.getElementById("daily-countdown").innerHTML= `<p class="text-yellow"><b>${hours}:${mins}:${secs}</b></p>`
            }
            
            setInterval(function(){
                millis -= 1000;
                displaytimer();
            }, 1000);
          }
      })
  }
                                                                                    
