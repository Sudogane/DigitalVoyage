  const lastTimeDailyRedeem = new Date("<%- userData.modules.cooldowns.daily %>").getTime()
  const canRedeemDaily = lastTimeDailyRedeem < Date.now()
  let dailyInterval
  let now = Date.now()
  let lostDailyStreak = ![0, 946692000000].includes(lastTimeDailyRedeem) && now - lastTimeDailyRedeem > 151200000
  
  handleDailyNotification()
  function handleDailyNotification() {
    var millis = lastTimeDailyRedeem - Date.now();

    function displaytimer(){
      var hours = Math.floor(millis / 36e5),
      mins = Math.floor((millis % 36e5) / 6e4),
      secs = Math.floor((millis % 6e4) / 1000);

      if(hours < 0 && mins < 0 && secs < 0) {
        clearInterval(dailyInterval)
        return addDailyNotification() 
      }
    }

    dailyInterval = setInterval(function(){
      millis -= 1000;
      displaytimer();
    }, 1000); 
  }
                             
  function addDailyNotification() {
    const dailyButton = document.getElementById("nav-daily")
    dailyButton.innerHTML += "<span class='badge'></span>"
    dailyButton.classList.add("animate__animated")
    dailyButton.classList.add("animate__pulse", "animate__infinite")
  }

        
  async function getDailyRewards() {
    // fazer tratamento de erro depois.
    const response = await API.get("/daily/rewards")
    
    return response.data.rewards
  }
                             
  function redeemDailyReward(rewardIndex) {
    API.post("/daily/redeem", { rewardIndex }).then((response) => {
      if(response.status === 200) {
        Toastify({
          escapeMarkup: false,
          text: `<h4>${response.data.text}</h4>`,
          duration: 3000,
          close: false,
          gravity: "top",
          position: "center", 
          stopOnFocus: false,
          className: "app-toast success"
        }).showToast()  
        
        for(let i=0; i<response.data.streak; i++) {
          const RD = document.getElementById(`dailyreward-slot-${i}`)
          RD.classList.remove("animate__pulse")
        }
        
        const rewardDiv = document.getElementById(`dailyreward-slot-${response.data.index - 1}`)
        const streak = document.getElementById("daily-streak")
        const dtx = document.getElementById("daily-message")
        dtx.innerHTML = ""
        streak.textContent = response.data.streak
        
        rewardDiv.classList.remove("animate__infinite", "animate__pulse")
        const dailyButton = document.getElementById("nav-daily")
        dailyButton.innerHTML = `<img class="main-menu-icon" src="https://ik.imagekit.io/projectvoyage/Interface/ui_gift_lSDHNSYTG.png?updatedAt=1686881326809"> Daily`
        dailyButton.classList.remove("animate__infinite")
        rewardDiv.classList.add("animate__flash")
        rewardDiv.onclick = ""
        rewardDiv.classList.add("daily-reward-redeemed")
      }
      
    })
  }

  function generateDailyRewardsList(rewardsList, redeemable) {
    let rewards = ""
    
    rewardsList.forEach((reward, i) => {
      const isRedeemable = ((redeemable) === i) && canRedeemDaily
      const redeemDailyReward = `onclick=redeemDailyReward(${redeemable})`
      rewards += `
        <div id="dailyreward-slot-${i}" ${(isRedeemable) ? redeemDailyReward : ""} style="padding: 4px;" class="gacha-slot ${(i<(redeemable)) ? "daily-reward-redeemed" : ""} ${(isRedeemable) ? 'animate__animated animate__pulse animate__infinite' : ''}"><img style="width: 60px;" src="${reward.icon}"/></div>
      `  
    })
    
    return rewards
  }
                             
