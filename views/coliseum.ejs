<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<!-- style -->
	<link rel="stylesheet" href="/css/style.min.css">
	<link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/app.css">
  
  <script src="https://kit.fontawesome.com/d34c5a5f9e.js" crossorigin="anonymous"></script>
	<!-- favicon -->
	<link rel="icon" href="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/favicon.ico?v=1664078135563">
	<title>Digital Voyage | Coliseum</title>
    
  <meta name="theme-color" content="#30aaff">
  <meta name="description" content="Digital Voyage is a brand-new browser, Join-us and start your brand new Digital Adventure right now, the Digital Universe calls for you, Voyager!">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Digital.Voyage: Season One">
  <meta property="og:title" content="Digital Voyage - A Brand new Virtual Monster Browser-RPG">
  <meta property="og:description" content="🎮 Embark on a thrilling Digital Voyage as a Digital Explorer in our exciting new Browser Game! 🌟 Join-us now to explore the world of Digital Voyage🎲🐾, where you'll encounter Virtual Monsters, Bosses, and Lots of Fun. 🤖🔍 Become a Voyager and start your epic journey today! 🚀💫 Don't miss out on this captivating experience! Play now and embrace the excitement! 🎉🌌 Art By: thatsquirrelly">
  <meta property="og:image" content="https://img3.gelbooru.com//samples/19/ee/sample_19ee0fa08b4a12c8bfc94d594f16690f.jpg">
  <meta name="twitter:card" content="summary_large_image">
</head>

<body>
	<!-- NAVIGATION WRAP -->
	<%- include('../partials/navbar') %>
	<!-- /NAVIGATION WRAP -->

  <!-- OPEN MOBILE MENU WRAPPER -->
  <%- include("../partials/openMobileMenu")%>
  <!-- OPEN MOBILE MENU WRAPPER -->
    
    <!-- Mobile User Banner-->
    <%- include("../partials/tamer/banner")%>
    <!-- Mobile User Banner-->

		<!-- LIVE NEWS WIDGET WRAP -->
		<%- include("../partials/livenews") %>
			<!-- /LIVE NEWS WIDGET WRAP -->

			<!-- LAYOUT CONTENT FULL -->
			<div class="layout-content-1 layout-item-3-1 grid-limit">
				<!-- LAYOUT BODY -->
				<div class="layout-body layout-item layout-item-body">
					<!-- WIDGET ITEM -->
					<div class="widget-item">
						<!-- SECTION TITLE WRAP -->
						<div class="section-title-wrap violet">
							<h2 class="section-title medium layout-item-title"><img src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_campaign.png?v=1665098447605"> Coliseum</h2>
							<div class="section-title-separator"></div>
						</div>
						<!-- /SECTION TITLE WRAP -->
					</div>
					<!-- /WIDGET ITEM -->

        <!-- LAYOUT ITEM -->
        <div class="layout-item centered" style="">
          <div class="DV-message" style="justify-self: center; width: 50rem;">
            <img
              src="https://ik.imagekit.io/projectvoyage/Interface/Characters/Leomon_giPb4k1yh.png?updatedAt=1687113863671"
              style="width: 8%; margin-right: 16px; border-radius: 50%;"
            />
            <div style="display: inline-block; vertical-align: middle; width: 40rem;">
              <h4 style="margin-bottom: 4px;">
                Greetings, esteemed <%- userData.username %>, and behold the grandeur of the Coliseum!
              </h4>
              <p>
                Within its magnificent walls, you shall embark on an arduous journey, engaging in fierce battles to ascend the ranks of tamer prowess. 
                <br><b class="text-red">Beware: opponents change weekly, based on your current standing.</b>
            </div>
          </div>

          <div class="coliseum-entry-container" style="justify-self: center; margin-bottom: 16px;">
            <% opponents.forEach((opponent, i) => { %>
              <div style="coliseum-entry-oponent" id="coliseum-entry<%- i %>">
                <img src=<%- opponent.sprite %> width="80px"/>
              </div>
            <% }) %>
            
            <div style="position: relative">
              <p class="text-yellow" style="text-align: center; position: absolute; top: 160px; width: 258px; left: -9.5rem; text-shadow: 0 0 4px black"><b>Remaining Coliseum Attempts Today: <%- userData.modules.coliseumTickets %></b></p>
            </div>
          </div>
        </div>
        <!-- /LAYOUT ITEM -->
				</div>
				<!-- /LAYOUT BODY -->

				<!-- LAYOUT SIDEBAR 2 -->
				<div class="layout-sidebar2 layout-item gutter-medium">
          <!-- WIDGET SIDEBAR -->
          <%- include("../partials/tamer/sidebar/tamer") %>
          <%- include("../partials/tamer/sidebar/my_team") %>
					<!-- /WIDGET SIDEBAR -->
				</div>
				<!-- /LAYOUT SIDEBAR 2 -->
			</div>
			<!-- LAYOUT CONTENT FULL -->
          
      <%- include("../partials/footer") %>
          
    <!-- app bundle -->
    <script src="/app.bundle.min.js"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
      integrity="sha512-c42qTSw/wPZ3/5LBzD+Bw5f7bSF2oxou6wEb+I/lqeaKV5FDIfMvvRp772y4jcJLKuGUOpbJMdg/BTl50fJYAw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <%- include("../functions/main") %>

    <script>
      <% opponents.forEach((opponent, i) => { %>
      tippy("#coliseum-entry<%- i %>",{
        theme: "maintheme",
        allowHTML: true,
        interactive: true,
        placement: "left",
        content: `
          <div style="padding: 8px;">
                    <div class="section-title-wrap blue" style="margin-bottom: 16px; margin-top: 8px;">
                      <h2 class="section-title small"><%- opponent.name %></h2>
                      <div class="section-title-separator"></div>
                    </div>
                    
                    <div>
                      <h5 style="text-align: center;">The oponent says:</h5>
                      <p style="text-align: center; padding: 8px; margin-bottom: 8px;"><%- opponent.dialogues.beforeEnteringBattle %></p>
                      
                      <h5 style="text-align: center;">Min Party Power:</h5>
                      <p style="text-align: center; padding: 8px;">PLACEHOLDER Party Power</p>
                      
                      <h5 style="text-align: center;">Battle Difficulty:</h5>
                      <p style="text-align: center; padding: 8px;"><%- opponent.rank %></p>
                      
                      <div style="display: flex; justify-content: center;">
                          <a onclick="challenge(<%- opponent.id %>)" class="button blue <%- (userData.modules.coliseumTickets > 0) ? "" : "disabled"%>" style="margin-top: 16px; padding: 0 16px;"><i class="fa-solid fa-location-crosshairs"></i> Fight <%- opponent.name %></a>
                      </div>
                    </div>
          </div>
        `
      })
      <% })%>
      
      function challenge(enemy) {
        API.post("/coliseum/createBattle", { enemy }).then(({data}) => {
          if(data.action === "redirectToBattle") location.href = `/battle/coliseum/${data.to}`
        })
      }
    </script>


</body>
</html>