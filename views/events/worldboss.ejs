            <marquee style="position: absolute; width: 68.3%; left: 2.3rem; top: 45rem;"><h3 class="text-green">At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure. At present, the barrier remains secure.</h3></marquee>
            <% } %>
          </div>
            
          <div style="display: flex; justify-content: center; margin-bottom: 2rem;">
            <% if(worldBoss.open) { %>
              <a onclick="challengeWorldBoss()" class="button button-normal blue"><i class="fa-solid fa-location-crosshairs"></i> Challenge the Boss </a>
            <% } %>
          </div>
            
          <div>
          <% if (worldBoss.leaderboard.length) { %>
          
          <div style="text-align: center; margin-bottom: 1rem;"><h3>Damage Leaderboard</h3></div>
            
          <div class="grid-5col_1 centered" style="display: flex; justify-content: center; margin-bottom: 2rem;">
            <% worldBoss.leaderboard.sort((a,b) => b.totalDamage - a.totalDamage).forEach((position, i) => { %>
              <div class="column">
                <div class="user-card" style="text-align: center; width: 12rem; display: inline-grid; justify-content: center;">
                  <div onclick="" style="box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px;border-radius: 8px; margin-bottom: 16px; height: 127px; width: 127px; background-image: url(<%- position.data.avatarUrl || position.data.costume?.avatarUrl %>); background-position: center center; background-size: cover; background-repeat: no-repeat;"></div>
                  <h4 class="username"> <%- position.data.username %></h4>
                  <p><span class="ui-icon ui-icon-extra ui-icon-attack"></span> <%- position.totalDamage %></p>
                  <% const rewardAmounts = [28, 18, 15, 5] %>
                  <p><span class="ui-icon ui-icon-extra icon-data"></span> <%- (i<3) ?  rewardAmounts[i] : rewardAmounts[3]%></p>
                </div>
              </div>
            <% }) %>
          </div>

          <% } %>
          </div>
            
        </div>
        <!-- /LAYOUT ITEM -->
				</div>
				<!-- /LAYOUT BODY -->

				<!-- LAYOUT SIDEBAR 2 -->
				<div class="layout-sidebar2 layout-item gutter-medium">
          <!-- WIDGET SIDEBAR -->
          <%- include("../../partials/tamer/sidebar/sidebar") %>
					<!-- /WIDGET SIDEBAR -->
				</div>
				<!-- /LAYOUT SIDEBAR 2 -->
			</div>
			<!-- LAYOUT CONTENT FULL -->
        
      <%- include("../../partials/footer") %>
          
    <!-- app bundle -->
    <script src="/app.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.33/dist/sweetalert2.all.min.js"></script>
    <%- include("../../functions/main") %>
      
    <script>
      function challengeWorldBoss() {
        API.post("/events/worldboss/", {}).then(({data}) => {
          if(data.action === "redirectToBattle") location.href = `/battle/events/worldBossNormal`
        })
      }
    </script>

</body>
</html>