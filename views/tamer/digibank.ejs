      </div>
      <!-- /TAB WRAP -->
              
          <% } else { %>
          <div class="grid-5col_1 centered no-gutter" style="display: flex; justify-content: center; flex-wrap: wrap; background: url('https://ik.imagekit.io/projectvoyage/Interface/Backgrounds/image_2022-10-29_103036523_eYRsIqe2t.png?updatedAt=1667050245820'); background-size: cover; background-position: center; padding: 32px; margin-top: -32px;">
            
          <div class="DV-message" style="justify-self: center; width: 50rem; margin-bottom: 32px;">
            <img
              src="https://ik.imagekit.io/projectvoyage/Digimons/Datamon_nM4idwN--.gif?ik-sdk-version=javascript-1.4.3&updatedAt=1670347687582"
