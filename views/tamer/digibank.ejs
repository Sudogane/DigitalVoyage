                  <% const dgmndbank = userData.modules.digibank[i]%>
                      <!-- DIGIMON PREVIEW -->
                      <div class="product-preview small" style="text-align:center; margin-left: 16px; margin-bottom: 16px;">
                        <!-- DIGIMON PREVIEW IMG WRAP -->
                        <div class="product-preview-img-wrap" style="box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px; border-radius: 8px;">
                          <!-- DIGIMON PREVIEW IMG -->
                          <a href="/digibank/<%- dgmndbank._id %>">
                            <figure class="product-preview-img box_digimon">
                              <img style="width: fit-content; max-width: 82px; max-height: 82px;" class="<%- (dgmndbank.health === 0) ? 'battle-defeated' : ''%>" src="<%- dgmndbank.sprite %>" alt="<%- dgmndbank.species %>">
                              <span class="ui-icon ui-icon-tier-<%- dgmndbank.tier.toLowerCase() %>" style="margin: 0; position: absolute; top: 64%; left: 74%; height: 24px;"></span>
                            </figure>
                          </a>
                          <!-- /DIGIMON PREVIEW IMG -->
                        </div>
                        <!-- /DIGIMON PREVIEW IMG WRAP -->
                      </div>
                      <!-- /DIGIMON PREVIEW -->
                <% } else { %>
                    <!-- MY TEAM DIGIMON PREVIEW -->
                    <div class="inventory-item-preview empty party-preview" style="margin-left: 16px !important; margin-bottom: 16px; box-shadow: rgba(0, 0, 0, 0.19) 0px 10px 20px, rgba(0, 0, 0, 0.23) 0px 6px 6px; border-radius: 8px;">
