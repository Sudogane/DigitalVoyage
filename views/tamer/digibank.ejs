                        <a style="margin-bottom: 16px;" onclick="createDigimon('<%- digimon[0] %>')" class="button blue small <%- (digimon[1].scanAmount >= 100 && userData.modules.digibank.length !== userData.modules.capacities.digibank) ? "" : 'disabled' %>" style="margin-top: 8px; padding: 0 24px;">Digitalize</a>
                      </div>
                      <!-- /DIGIMON PREVIEW -->
            <% }) %>
          </div>
          

          <% } %>
          
					<!-- WIDGET ITEM -->
					<div class="widget-item">
