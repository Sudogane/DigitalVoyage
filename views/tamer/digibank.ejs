				</div>
				<!-- /LAYOUT BODY -->

				<!-- LAYOUT SIDEBAR 2 -->
				<div class="layout-sidebar2 layout-item gutter-medium">
          <!-- WIDGET SIDEBAR -->
          <%- include("../../partials/tamer/sidebar/tamer") %>
          <%- include("../../partials/tamer/sidebar/my_team") %>
					<!-- /WIDGET SIDEBAR -->
				</div>
				<!-- /LAYOUT SIDEBAR 2 -->
			</div>
			<!-- LAYOUT CONTENT FULL -->

			<%- include("../../partials/footer") %>
      <%- include("../../functions/main") %>

				<!-- app bundle -->
				<script src="/app.bundle.min.js"></script>
				<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.33/dist/sweetalert2.all.min.js"></script>
				<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css" />
				<script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js"></script>

				<style>
					.swiper {
						width: 100%;
						height: 400px;
					}
				</style>
        
        <script>
          function openUpgradeDigibankModal() {
              swal.fire({
                showConfirmButton: false,
                html: `
                  <div style="height: max-content; padding: 16px;">
                    <img style="width: 100px; margin-top: 4px;" class="floater" src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_digibank.png?v=1665508150671"></img>
                    <div class="upgrade-info-container">
                      <p><b class="text-white">Current Capacity:</b> <%- userData.modules.capacities.digibank %></p>
                      <p><b class="text-white">Digimon Data Stored:</b> <%- userData.modules.digibank.length %> Digimon Data</p>

                      <br>
                      <p><b class="text-white">Upgraded Capacity:</b> <%- userData.modules.capacities.digibank + 15 %>
                      <p><b class="text-white">Upgrade Cost:</b> <%- Math.round(1550 * (userData.modules.capacities.digibank / 4.2) )%> Bits
                    </div>
                    
                    <a style="margin-top: 16px;" onclick="upgradeDigibank()" class="button button-normal small blue">Upgrade Digibank</a>
                  </div>
                      `
              })
          }
          
          async function upgradeDigibank() {
            try {
              const response = await API.post("/inventory/upgradeInventory", {});
              if (response.data) window.location.reload();
            } catch (error) {
              console.log(`Error while upgrading inventory: ${error}`);
              console.log(error.response);

              if (error.response && error.response.status === 400) {
                Toastify({
                  escapeMarkup: false,
                  text: `<h4>${error.response.data}</h4>`,
                  duration: 3000,
                  close: false,
                  gravity: "top",
                  position: "center",
                  stopOnFocus: false,
                  className: "app-toast failure",
                }).showToast();
              }
            }
          }
        </script>
        
				<script>
          XM_Tab({
            container: '#digimon-digibank-tab-wrap',
            selectedClass: 'active'
          });
          
          <% if(locals.digimonData) { %>
            const CDNB = document.getElementById("changeDigimonNickname")

            CDNB.addEventListener("click", () => {
              swal.fire({
                showConfirmButton: false,
                html: `<div class="section-title-wrap blue" style="margin-bottom: 16px;">
                          <h2 class="section-title medium" style="text-align: left;"><img class="ui-icon-30" src="https://ik.imagekit.io/projectvoyage/Interface/ui_edit_6gG-hR4gT.png?ik-sdk-version=javascript-1.4.3&updatedAt=1670297292963"> Edit Digimon Nickname</h2>
                          <div class="section-title-separator"></div>
                        </div>

                        <input type="text" maxlength=16 id="digimon_nickname" name="nickname" placeholder="Change <%- digimonData.nickname || digimonData.species %>'s Nickname">
                        <label style="margin-top:14px; margin-bottom: -4px; display: none;" id="nickname_error" class="rl-label">This is an Easter Egg</label>
                        <a id="editNickname" class="button blue" style="margin-top: 16px; padding: 0 16px;">Edit Nickname</a>
                      `
              })

              const DNB = document.getElementById("editNickname")
              const DN = document.getElementById("digimon_nickname")
              const ERR = document.getElementById("nickname_error")

              DNB.addEventListener("click", () => {
                DNB.classList.add("disabled")
                fetch("/api/digibank/digimon/change_nickname", {
                  method: "POST",
                  headers: {
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({ nickname: DN.value, id:  "<%- digimonData._id %>" })
                }).then((response) => response = response.json()).then((body) => {
                    if(body.error) {
                      ERR.innerHTML = body.error
                      ERR.style.display = "block"
                      ERR.style.color = "#f30a5c"
                      DNB.classList.remove("disabled")
                    } else {
                      if(ERR.style.display === "block") ERR.style.display = "none"
                      window.location.reload()
                    }
                })
              })
            })
          <% } %>
          // eVO!
          <% if(locals.evolutions) { %>
            function evolutionAnimation(digimon) {
    const _evolutionMusic = new Audio("https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/Digimon%20Tamers%20Battle%20Evolution%20Soundtrack%2002_%20Brave%20Heart.mp3?v=1689366365394")
    
    swal.fire({
      showConfirmButton: false,
      showClass: {
        popup: "animate__animated animate__fadeIn animate__faster"
      },
      customClass: {
        htmlContainer: "swal2-html-container-full"
      },
      width: '46rem',
      padding: '0rem',
      html: `
        <div class="_evolutionContainer">
          <div class="_evolutionBackgroundAnimation">
            <h2 id="_digimonToEvolveTitle1" style="position: absolute; left: 1rem;" class=" animate__animated animate__slideInRight"><%- digimonData.nickname || digimonData.species %> evolves to...</h2>
            <h2 id="_digimonToEvolveTitle2" style="position: absolute; text-align: right; top: 24rem; right: 1rem;" class=" animate__animated animate__slideInLeft"><%- digimonData.nickname || digimonData.species %> evolves to...</h2>
            <div id="_digimonToEvolveSprite"  style="background: url('<%- digimonData.sprite %>'); background-repeat: no-repeat; background-position: center; height: 26rem;"></div>
            <div id="_digimonToEvolveAura" style="position: absolute; width: 100%; top: 1rem; background-repeat: no-repeat; background-position: center; height: 26rem;"></div>
          </div>
        </div>
      `,
      didOpen: () => {
        const sprite = document.getElementById("_digimonToEvolveSprite");
        const aura = document.getElementById("_digimonToEvolveAura");
        const t1 = document.getElementById("_digimonToEvolveTitle1");
        const t2 = document.getElementById("_digimonToEvolveTitle2");

        _evolutionMusic.play();

        setTimeout(() => {
          sprite.classList.add("animate__animated", "animate__infinite", "animate__flash");

          setTimeout(() => {
            sprite.classList.add("animate__fast");

            t1.classList.replace("animate__slideInRight", "animate__fadeOut");
            t2.classList.replace("animate__slideInLeft", "animate__fadeOut");

            setTimeout(() => {
              sprite.classList.remove("animate__fast", "animate__infinite", "animate__flash");
              sprite.classList.add("_evoAnim1");

              setTimeout(() => {
                aura.style.backgroundImage = "url('https://cdn.glitch.global/01f4400b-53dc-443a-be28-dae1dfeaf721/4DSRYL.gif?v=1689364190073')";

                setTimeout(() => {
                  sprite.style.backgroundImage = `url(${digimon.sprite})`;
                  aura.style.backgroundImage = "";

                  setTimeout(() => {
                    sprite.classList.add("_evoAnim2");

                    setTimeout(() => {
                      t1.innerHTML = `...${digimon.species}!`;
                      t1.classList.replace("animate__fadeOut", "animate__slideInRight");

                      t2.innerHTML = `${digimon.species}!...`;
                      t2.classList.replace("animate__fadeOut", "animate__slideInLeft");
                    }, 100);

                  }, 200);

                }, 1500);

              }, 500);

            }, 1500);

          }, 4500);

        }, 2500);

        
      }, 
      willClose: () => {
        setInterval(() => {
          if(_evolutionMusic.volume > 0) _evolutionMusic.volume -= 0.1
        }, 100)
        
        setTimeout(() => {
          window.location.reload()
        }, 1000)
      }
    })
  }
                <%
                
                  let tamerRankRequirementToEvolve = {
                    "In-Training": 1,
                    "Rookie": 2,
                    "Champion": 4,
                    "Ultimate": 6,
                    "Mega": 10
                  };
                  
                %>
            
            <% if(evolutions.to) { %>
              <% evolutions.to.forEach(evo => { %>
                <% if(evo.sXpType) { %>
              
                XM_Tooltip({
                  container: '#TT_Evo_<%- evo.id %>',
                  type: 'html',
                  direction: 'bottom',
                  align: 'center',
                  animation: {
                    type: 'translate-out-fade'
                  },
                  htmlContent: `
                  <div class="TT-evolution">
                    <div class="section-title-wrap blue" style="margin-bottom: 16px;">
                      <h2 class="section-title small"><%- evo.species %></h2>
                      <div class="section-title-separator"></div>
                    </div>

                    <% 
                      let evoSXPType;

                                   switch(evo.sXpType.toLowerCase()) {
                                     case "dragon":
                                        evoSXPType = "dragonsroar"
                                     break;
                                     case "holy":
                                        evoSXPType = "virusbusters"
                                     break;
                                     case "dark":
                                        evoSXPType = "nightmaresoldiers"
                                     break;
                                     case "beast":
                                        evoSXPType = "naturespirits"
                                     break;
                                     case "bird":
                                        evoSXPType = "windguardians"
                                     break;
                                     case "machine":
                                        evoSXPType = "metalempire"
                                     break;
                                     case "aquatic":
                                        evoSXPType = "deepsavers"
                                     break;
                                     case "plant/insect":
                                        evoSXPType = "jungletroopers"
                                     break;
                                   }
                    %>

                    <div style="text-align: center;">
                      <h5 style="margin-bottom: 8px;">Minimum Level: <p style="color: <%- (evo.minLevel > digimonData.level) ? "red" : "green" %>;"><%- digimonData.level %>/<%- evo.minLevel %></p></h5>
                      <h5>Minimum S.EXP: 
                        <div class="ui-icon-wrap" style="margin-bottom: 8px; justify-content: center;">
                          <span class="ui-icon ui-icon-family-<%- evoSXPType %>"></span>
                            <p style="font-weight: 600; color: <%- (evo.sXpAmount > digimonData.sExp[evo.sXpType.toLowerCase()]) ? "red" : "green" %>;"><%- digimonData.sExp[evo.sXpType.toLowerCase()] %>/<%- evo.sXpAmount %></p>
                        </div>
                      <h5 style="margin-bottom: 8px;">Minimum Tamer Rank: <p style="color: <%- (tamerRankRequirementToEvolve[evo.form] > userData.modules.level) ? "red" : "green" %>;"><%- userData.modules.level %>/<%- tamerRankRequirementToEvolve[evo.form] %></p></h5>
                      </h5>
                      
                      <%
                        let canEvolve = false
                        let hasEnoughSExp = evo.sXpAmount <= digimonData.sExp[evo.sXpType.toLowerCase()]
                        let hasEnoughLevel = evo.minLevel <= digimonData.level
                        let hasCompletedTamerRankRequirement = userData.modules.level >= tamerRankRequirementToEvolve[evo.form]
          
                        //console.log(hasEnoughSExp, hasEnoughLevel, hasCompletedTamerRankRequirement)
          
                        if(hasEnoughSExp && hasEnoughLevel && hasCompletedTamerRankRequirement) canEvolve = true
                      %>
                      
                      <% if(canEvolve) { %>
                        <a style="margin-top: 8px;" onclick="evolve(<%- evo.id %>)" class="button button-normal small blue">Evolve</a>
                      <% } %>

                    </div>
                  </div>
                  `
                });
                
              <% } %>
              
              <% }) %>
                
              function evolve(id) {
                API.post("/digibank/digimon/evolve", { evolutionId: id, digimonId: "<%- digimonData._id %>"}).then(({ data }) => {
                  if(data.type === "success") evolutionAnimation(data.digimon)
                })
              }
            <% } %>
              
              <% if(evolutions.from) { %>
              <% evolutions.from.forEach(evo => { %>
                
                <% if(evo.sXpType) { %>
              
                XM_Tooltip({
                  container: '#TT_Evo_<%- evo.id %>',
                  type: 'html',
                  direction: 'bottom',
                  align: 'center',
                  animation: {
                    type: 'translate-out-fade'
                  },
                  htmlContent: `
                  <div class="TT-evolution">
                    <div class="section-title-wrap blue" style="margin-bottom: 16px;">
                      <h2 class="section-title small"><%- evo.species %></h2>
                      <div class="section-title-separator"></div>
                    </div>

                    <% 
                      let evoSXPType;

                                   switch(evo.sXpType.toLowerCase()) {
                                     case "dragon":
                                        evoSXPType = "dragonsroar"
                                     break;
                                     case "holy":
                                        evoSXPType = "virusbusters"
                                     break;
                                     case "dark":
                                        evoSXPType = "nightmaresoldiers"
                                     break;
                                     case "beast":
                                        evoSXPType = "naturespirits"
                                     break;
                                     case "bird":
                                        evoSXPType = "windguardians"
                                     break;
                                     case "machine":
                                        evoSXPType = "metalempire"
                                     break;
                                     case "aquatic":
                                        evoSXPType = "deepsavers"
                                     break;
                                     case "plant/insect":
                                        evoSXPType = "jungletroopers"
                                     break;
                                   }
                    %>

                    <div style="text-align: center;">
                      <h5 style="margin-bottom: 8px;">Minimum Level: <p style="color: <%- (evo.minLevel > digimonData.level) ? "red" : "green" %>;"><%- digimonData.level %>/<%- evo.minLevel %></p></h5>
                      <h5>Minimum S.EXP: 
                        <div class="ui-icon-wrap" style="margin-bottom: 8px; justify-content: center;">
                          <span class="ui-icon ui-icon-family-<%- evoSXPType %>"></span>
                            <p style="font-weight: 600; color: <%- (evo.sXpAmount > digimonData.sExp[evo.sXpType.toLowerCase()]) ? "red" : "green" %>;"><%- digimonData.sExp[evo.sXpType.toLowerCase()] %>/<%- evo.sXpAmount %></p>
                        </div>
                      <h5 style="margin-bottom: 8px;">Minimum Tamer Rank: <p style="color: <%- (tamerRankRequirementToEvolve[evo.form] > userData.modules.level) ? "red" : "green" %>;"><%- userData.modules.level %>/<%- tamerRankRequirementToEvolve[evo.form] %></p></h5>
                      </h5>
                      
                      <%
                        let canEvolve = false
                        let hasEnoughSExp = evo.sXpAmount <= digimonData.sExp[evo.sXpType.toLowerCase()]
                        let hasEnoughLevel = evo.minLevel <= digimonData.level
                        let hasCompletedTamerRankRequirement = userData.modules.level >= tamerRankRequirementToEvolve[evo.form]
          
                        //console.log(hasEnoughSExp, hasEnoughLevel, hasCompletedTamerRankRequirement)
          
                        if(hasEnoughSExp && hasEnoughLevel && hasCompletedTamerRankRequirement) canEvolve = true
                      %>
                      
                      <% if(canEvolve) { %>
                        <a style="margin-top: 8px;" onclick="degenerate(<%- evo.id %>)" class="button button-normal small blue">Degenerate</a>
                      <% } %>
                    </div>
                  </div>
                  `
                });
                
              <% } %>
              
              <% }) %>
                
              function degenerate(id) {
                API.post("/digibank/digimon/degenerate", { evolutionId: id, digimonId: "<%- digimonData._id %>"}).then(({ data }) => {
                  if(data.type === "success") evolutionAnimation(data.digimon)
                })
              }
            <% } %>
          <% } %>
            
              function createDigimon(species) {
                  API.post("/digibank/scans/create", { species}).then(({ data }) => {
                    if(data.type === "success") window.location.reload()
                  })
                }  
                                    
				</script>
        
<script>
  
  <% if(locals.isOnParty) { %>
    function removeFromParty(_id) {
      API.post("/digibank/digimon/removeFromParty", { _id }).then(({ data }) => {
        if(data.type === "success") window.location.reload()
      })
    }
  <% } else { %>
    function addToParty(_id) {
      API.post("/digibank/digimon/addToParty", { _id }).then(response => {
        if(response.data.type === "success") return window.location.reload()
      }).catch(err => {
        Toastify({
          escapeMarkup: false,
          text: `<h4>${err.response.data}</h4>`,
          duration: 3000,
          close: false,
          gravity: "top",
          position: "center",
          stopOnFocus: false,
          className: "app-toast failure",
        }).showToast();
      })
    }
  <% } %>
    
  function release(_id) {
    API.post("/digibank/digimon/release", { _id }).then(({ data }) => {
      if(data.type === "success") window.location.href = "/digibank/"
    })
  }
             
          <%
            function gerarEstrelas(numero) {
              let estrelas = '';

              for (let i = 0; i < numero; i++) {
                estrelas += '\u2605';
              }

              return estrelas;
            }  
          %>
             
  <% if(locals.digimonData && digimonData.equipment && Object.keys(digimonData.equipment).length) { %>
  <% const thisItem = digimonData.equipment %>
  function unequip(_id) {
    API.post("/digibank/digimon/unequip", { _id }).then(window.location.reload())
  }
  
  function openUpgradeModal() {
    swal.fire({
      showConfirmButton: false,
        html: `<div class="section-title-wrap" style="margin-bottom: 16px; text-align: center;">
          <h2 class="section-title medium"><%- thisItem.name %></h2>
          <span class="text-yellow"><%- gerarEstrelas(thisItem.rarity || 1) %></span>
        </div>

        <p>This is an work in progress feature.</p>
      `
    })
  }

    
tippy("#equiped_item", {
    theme: "maintheme",
    allowHTML: true,
    interactive: true,
    placement: "left",
    content: `
                   <div>
                    <div style="display: flex; justify-content: center; border-radius: 0 16px 0 0;" class="background-rarity-<%- thisItem.rarity || 4 %>">
                      <img style="width: fit-content; max-width: 142px; max-height: 142px;" src="<%- thisItem.icon %>">
                    </div>

                    <div class="TT-evolution">
                      <div style="margin-bottom: 16px; text-align: center;">
                        <h3><%- thisItem.name %></h3>
                        <span><%- gerarEstrelas(thisItem.rarity || 1) %></span>
                        <p><%- `${thisItem.type.charAt(0).toUpperCase()}${thisItem.type.slice(1, thisItem.type.length)}` %></p>
                      </div>

                      <div style="text-align: center">
                        <h4>Level: <p style="display: inline;"><%- thisItem.level || "Undefined" %></p><h4>
                      </div>

                      <div class="party-modal-stats" style="padding: 4px;">
                        <div style="display: flex; justify-content: center; text-align: center; gap: 8px;">
                          <p><b>Atk:</b> +<%- thisItem.mainStat %></p>
                          <p><b><%- thisItem.subStat%>:</b> +<%- thisItem.statAmountIncrease %></p>
                        </div>
                        <p style="text-align: left; padding: 4px;"><b><%- thisItem.passive.name %>:</b><br><%- thisItem.passive.description %></p>
                      </div>
                      
                      <div style="margin-top: 8px; display: flex; gap: 4px; justify-content: center;">
                        <a onclick="unequip('<%- digimonData._id %>')" class="button blue small"><i class="fa-solid fa-square-minus"></i> Unequip</a>
                        <a onclick="openUpgradeModal()" class="button blue small"><i class="fa-solid fa-square-plus"></i> Upgrade</a>
                      </div>
                  </div>
    `
  })
    
  <% } %>
  
</script>
            

</body>

</html>