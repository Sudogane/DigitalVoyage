          <% if(!locals.digimonData) { %>
					<!-- WIDGET ITEM -->
					<div class="widget-item">
						<!-- SECTION TITLE WRAP -->
						<div class="section-title-wrap blue">
							<h2 class="section-title medium layout-item-title"><img width=40 height=40 src="https://ik.imagekit.io/projectvoyage/Interface/ui_scan_yRcxrOVec.png?updatedAt=1683830108428"> Scans</h2>
							<div class="section-title-separator"></div>
						</div>
						<!-- /SECTION TITLE WRAP -->
					</div>
					<!-- /WIDGET ITEM -->
          
