<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<!-- style -->
	<link rel="stylesheet" href="/css/style.min.css">
	<link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/app.css">
  
  <script src="https://kit.fontawesome.com/d34c5a5f9e.js" crossorigin="anonymous"></script>
	<!-- favicon -->
	<link rel="icon" href="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/favicon.ico?v=1664078135563">
	<title>Digital Voyage | <%- userData.username %></title>
    
  <meta name="theme-color" content="#30aaff">
  <meta name="description" content="Digital Voyage is a brand-new browser, Join-us and start your brand new Digital Adventure right now, the Digital Universe calls for you, Voyager!">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Digital.Voyage: Season One">
  <meta property="og:title" content="Digital Voyage - A Brand new Virtual Monster Browser-RPG">
  <meta property="og:description" content="🎮 Embark on a thrilling Digital Voyage as a Digital Explorer in our exciting new Browser Game! 🌟 Join-us now to explore the world of Digital Voyage🎲🐾, where you'll encounter Virtual Monsters, Bosses, and Lots of Fun. 🤖🔍 Become a Voyager and start your epic journey today! 🚀💫 Don't miss out on this captivating experience! Play now and embrace the excitement! 🎉🌌 Art By: thatsquirrelly">
  <meta property="og:image" content="https://img3.gelbooru.com//samples/19/ee/sample_19ee0fa08b4a12c8bfc94d594f16690f.jpg">
  <meta name="twitter:card" content="summary_large_image">
</head>

<body>
	<!-- NAVIGATION WRAP -->
	<%- include('../../partials/navbar') %>
	<!-- /NAVIGATION WRAP -->
    
  <!-- OPEN MOBILE MENU WRAPPER -->
  <%- include("../../partials/openMobileMenu")%>
  <!-- OPEN MOBILE MENU WRAPPER -->

    <!-- Mobile User Banner-->
    <%- include("../../partials/tamer/banner")%>
    <!-- Mobile User Banner-->
      
		<!-- LIVE NEWS WIDGET WRAP -->
		<%- include("../../partials/livenews") %>
			<!-- /LIVE NEWS WIDGET WRAP -->

			<!-- LAYOUT CONTENT FULL -->
			<div class="layout-content-1 layout-item-3-1 grid-limit">
				<!-- LAYOUT BODY -->
				<div class="layout-body layout-item">
					<!-- WIDGET ITEM -->
					<div class="widget-item">
						<!-- SECTION TITLE WRAP -->
						<div class="section-title-wrap violet">
							<h2 class="section-title medium"><img src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/ui_myHome.png?v=1665342182400"> My Home</h2>
							<div class="section-title-separator"></div>
						</div>
						<!-- /SECTION TITLE WRAP -->
					</div>
					<!-- /WIDGET ITEM -->

					<!-- Slider main container -->
					<div class="swiper">
						<div class="swiper-wrapper">
							<!-- Slides -->
							<div class="swiper-slide">
								<figure class="post-open-img"
									style="background-image: url('https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/16_flat.jpg?v=1664210407344'); background-size: cover; background-position: center center; background-repeat: no-repeat;">
									<img src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/39.jpg?v=1663868356831"
										alt="post-project-voyage" style="display: block;">
								</figure>
							</div>
							<div class="swiper-slide">
								<figure class="post-open-img"
									style="background-image: url('https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/16_flat.jpg?v=1664210407344'); background-size: cover; background-position: center center; background-repeat: no-repeat;">
									<img src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/39.jpg?v=1663868356831"
										alt="post-project-voyage" style="display: block;">
								</figure>
							</div>
							<div class="swiper-slide">
								<figure class="post-open-img"
									style="background-image: url('https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/16_flat.jpg?v=1664210407344'); background-size: cover; background-position: center center; background-repeat: no-repeat;">
									<img src="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/39.jpg?v=1663868356831"
										alt="post-project-voyage" style="display: block;">
								</figure>
							</div>
						</div>
						<div class="swiper-pagination"></div>
					</div>


					<div class="post-preview-showcase grid3-1col centered">
						<% newsList.forEach((post)=> { %>
							<!-- POST PREVIEW -->
							<div class="post-preview landscape e-sport">
								<!-- POST PREVIEW IMG WRAP -->
								<a href="/news/<%- post.id %>">
									<div class="post-preview-img-wrap">
										<!-- POST PREVIEW IMG -->
										<figure class="post-preview-img liquid imgLiquid_bgSize imgLiquid_ready"
											style="background-image: url(<%- post.thumbnail %>); background-size: cover; background-position: center center; background-repeat: no-repeat;">
											<img src=<%- post.thumbnail %> alt="post-36" style="display: none;">
										</figure>
										<!-- POST PREVIEW IMG -->
									</div>
								</a>
								<!-- /POST PREVIEW IMG WRAP -->

								<!-- TAG ORNAMENT -->
								<a href="/news/<%- post.id %>" class="tag-ornament">
									<%- post.category %>
								</a>
								<!-- /TAG ORNAMENT -->

								<!-- POST PREVIEW TITLE -->
								<a href="/news/<%- post.id %>" class="post-preview-title">
									<%- post.title %>
								</a>
								<!-- POST AUTHOR INFO -->
								<div class="post-author-info-wrap">
									<p class="post-author-info small light">By <a href="search-results.html"
											class="post-author">ADMIN</a><span class="separator">|</span>
										<%- post.creationDate %>
									</p>
								</div>
								<!-- /POST AUTHOR INFO -->
								<!-- POST PREVIEW TEXT -->
								<p class="post-preview-text">
									<%- post.description %>
								</p>
							</div>
							<!-- /POST PREVIEW -->
							<% }) %>

					</div>

					<!-- /POST PREVIEW SHOWCASE -->

					<!-- LAYOUT ITEM -->
					<div class="layout-item centered padded read-more-wrap">
						<!-- BUTTON -->
						<a href="#" class="button violet">
							Load more news...
							<!-- BUTTON ORNAMENT -->
							<div class="button-ornament">
								<!-- ARROW ICON -->
								<svg class="arrow-icon medium">
									<use xlink:href="#svg-arrow-medium"></use>
								</svg>
								<!-- /ARROW ICON -->

								<!-- CROSS ICON -->
								<svg class="cross-icon small">
									<use xlink:href="#svg-cross-small"></use>
								</svg>
								<!-- /CROSS ICON -->
							</div>
							<!-- /BUTTON ORNAMENT -->
						</a>
						<!-- /BUTTON -->
					</div>
					<!-- /LAYOUT ITEM -->
				</div>
				<!-- /LAYOUT BODY -->

				<!-- LAYOUT SIDEBAR 2 -->
				<div class="layout-sidebar2 layout-item gutter-medium">
          <!-- WIDGET SIDEBAR -->
          <%- include("../../partials/tamer/sidebar/tamer") %>
          <%- include("../../partials/tamer/sidebar/my_team") %>
					<!-- /WIDGET SIDEBAR -->
				</div>
				<!-- /LAYOUT SIDEBAR 2 -->
			</div>
			<!-- LAYOUT CONTENT FULL -->

			<%- include("../../partials/footer") %>

				<!-- app bundle -->
				<script src="app.bundle.min.js"></script>
				<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.4.33/dist/sweetalert2.all.min.js"></script>
				<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css" />
				<script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js"></script>
        <%- include("../../functions/main") %>

				<style>
					.swiper {
						width: 100%;
						height: 400px;
					}
				</style>
				<script>
          <% if(locals.userData && userData.newAccount === 0) { %>
              window.location = "/"
          <% } %>
					const swiper = new Swiper('.swiper', {
						direction: 'horizontal',
						loop: true,
						autoplay: {
							delay: 2800,
							disableOnInteraction: false
						},
						pagination: {
							el: '.swiper-pagination',
							clickable: true
						}
					});
          
          XM_ProgressBar({
            container: '#progress-bar-pp-01',
            width: 300,
            height: 6,
            scale: {
              start: 0,
              end: 100,
              stop: 64
            },
            speed: 30,
            gradient: {
              colors: ['#713fcb', '#00e3d0']
            },
            linkText: true
          })
				</script>

				<% if(userData.newAccount===1 && !userData.costume) { %>
					<script>
						const selectCharacterPopup = swal.fire({
							padding: "0px",
							title: `<h4 class="section-title small">Select your Character</h4><div class="section-title-separator"></div>`,
							customClass: {
								title: "section-title-wrap blue",
								popup: "popupTutorialOne"
							},
							allowOutsideClick: false,
							showConfirmButton: false,
              allowEscapeKey: false,
							html: `
        <div class="form-wrap">
          <!-- FORM ROW -->
          <div class="form-row">
<h4 style="margin-bottom: 24px;">Which tamer fits you more?</h4>
    
    <div class="grid-2col_1 centered">
          <!-- COLUMN -->
          <div class="column">
            <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Costumes/Koh_bUH-3wq2Z.gif?updatedAt=1666195548395" style="width: 35%"></img></div>
            
<div class="radio-item">
        <input type="radio" id="character_selection_koh" name="select_character" value="character_selection_koh" checked="checked">
        <!-- RADIO CIRCLE -->
        <div class="radio-circle"></div>
        <!-- RADIO CIRCLE -->
        <label for="character_selection_koh" class="rl-label">Koh</label>
      </div>
            
          </div>
          <!-- /COLUMN -->

          <!-- COLUMN -->
          <div class="column">
            <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Costumes/Sayo_h_vOVntCI.gif?updatedAt=1666195548471" style="width: 35%"></img></div>
            
<div class="radio-item">
        <input type="radio" id="character_selection_sayo" name="select_character" value="character_selection_sayo">
        <!-- RADIO CIRCLE -->
        <div class="radio-circle"></div>
        <!-- RADIO CIRCLE -->
        <label for="character_selection_sayo" class="rl-label">Sayo</label>
      </div>
      
          </div>
          <!-- /FORM ROW -->
        </div>
          <!-- FORM ACTIONS -->
          <div class="form-actions full">
            <!-- BUTTON -->
            <button id="register_character_button" class="button blue">
              Continue
              <!-- BUTTON ORNAMENT -->
              <span class="button-ornament">
                <!-- ARROW ICON -->
                <svg class="arrow-icon medium">
                  <use xlink:href="#svg-arrow-medium"></use>
                </svg>
                <!-- /ARROW ICON -->

                <!-- CROSS ICON -->
                <svg class="cross-icon small">
                  <use xlink:href="#svg-cross-small"></use>
                </svg>
                <!-- /CROSS ICON -->
              </span>
              <!-- /BUTTON ORNAMENT -->
            </button>
            <!-- /BUTTON -->
          </div>
          <!-- /FORM ACTIONS -->
        <!-- /FORM WRAP -->
    `
						})

						var RCB = document.getElementById("register_character_button")
						var checkKoh = document.getElementById("character_selection_koh")
						var checkSayo = document.getElementById("character_selection_sayo")

						RCB.addEventListener("click", () => {
              RCB.classList.add("disabled")
							var costume = (checkKoh.checked) ? "koh" : "sayo"

							fetch('/api/register/character', {
								method: 'POST',
								headers: {
									'Content-Type': 'application/json',
								},
								body: JSON.stringify({ costume })
							}).then((response) => response = response.json()).then((body) => {
								if (body.success) {
									selectCharacterPopup.close()
									swal.fire({
										padding: "0px",
										title: `<h4 class="section-title small">Select your Partner</h4><div class="section-title-separator"></div>`,
										customClass: {
											title: "section-title-wrap blue",
											popup: "popupTutorialOne"
										},
										allowOutsideClick: false,
										showConfirmButton: false,
                    allowEscapeKey: false,
										html: `
                <div class="form-wrap">
                  <!-- FORM ROW -->
                  <div class="form-row">
        <h4 style="margin-bottom: 24px;">Select a Digimon to be your first partner</h4>

            <div class="grid-3col_1 no-gutter centered" style="overflow: hidden;">
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Digimons/Koromon__bVvC0qix5.gif?updatedAt=1684420344750" style="width: 33%"></img></div>

                    <div class="radio-item">
                            <input type="radio" id="digimon_selection_koromon" name="select_starter" value="digimon_selection_koromon" checked="checked">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="digimon_selection_koromon" class="rl-label">Koromon</label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                  
                  
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Digimons/Tanemon_rxmdFG5Xn.gif?updatedAt=1684420415628" style="width: 33%"></img></div>

                    <div class="radio-item">
                            <input type="radio" id="digimon_selection_tanemon" name="select_starter" value="digimon_selection_tanemon">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="digimon_selection_tanemon" class="rl-label">Tanemon</label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                  
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Digimons/Tsunomon_d5Y82RFHf.gif?updatedAt=1684420414299" style="width: 20%"></img></div>

                    <div class="radio-item">
                            <input type="radio" id="digimon_selection_tsunomon" name="select_starter" value="digimon_selection_tsunomon">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="digimon_selection_tsunomon" class="rl-label">Tsunomon</label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                  <!-- /FORM ROW -->
                </div>
                  <label style="margin-top:14px; margin-bottom: -26px; display: none;" id="starter_selection_error" class="rl-label"></label>
                  <!-- FORM ACTIONS -->
                  <div class="form-actions full">
                    <!-- BUTTON -->
                    <button id="register_starter_button" class="button blue">
                      Continue
                      <!-- BUTTON ORNAMENT -->
                      <span class="button-ornament">
                        <!-- ARROW ICON -->
                        <svg class="arrow-icon medium">
                          <use xlink:href="#svg-arrow-medium"></use>
                        </svg>
                        <!-- /ARROW ICON -->

                        <!-- CROSS ICON -->
                        <svg class="cross-icon small">
                          <use xlink:href="#svg-cross-small"></use>
                        </svg>
                        <!-- /CROSS ICON -->
                      </span>
                      <!-- /BUTTON ORNAMENT -->
                    </button>
                    <!-- /BUTTON -->
                  </div>
                  <!-- /FORM ACTIONS -->
                <!-- /FORM WRAP -->
            `
									})

									var RSB = document.getElementById("register_starter_button")
									var SSE = document.getElementById("starter_selection_error")
									var checkList = document.querySelectorAll('[name=select_starter]')

									RSB.addEventListener("click", () => {
                    RSB.classList.add("disabled")
										var starter = 2
                    
										checkList.forEach(checkbox => {
											if (checkbox.checked) {
												if (checkbox.value === "digimon_selection_koromon") starter = 2
												if (checkbox.value === "digimon_selection_tanemon") starter = 6
												if (checkbox.value === "digimon_selection_tsunomon") starter = 3
											}
										})

										fetch('/api/register/starter', {
											method: 'POST',
											headers: {
												'Content-Type': 'application/json',
											},
											body: JSON.stringify({ starter })
										}).then((response) => response = response.json()).then((body) => {
											if (!body.success) {
												SSE.style.display = "block"
												SSE.style.color = "#f30a5c"
												SSE.innerHTML = body.error
											} else {
												SSE.style.display = "block"
												SSE.style.color = "#58d819"
												SSE.innerHTML = "Done, Redirecting..."

												window.location = "/me"
											}
										})

									})
								}
							})
						})

					</script>
				<% } %>
        
        <% if(userData.newAccount===2 && !userData.party) { %>
          <script>
                  swal.fire({
										padding: "0px",
										title: `<h4 class="section-title small">Select your Partner</h4><div class="section-title-separator"></div>`,
										customClass: {
											title: "section-title-wrap blue",
											popup: "popupTutorialOne"
										},
										allowOutsideClick: false,
										showConfirmButton: false,
                    allowEscapeKey: false,
										html: `
                <div class="form-wrap">
                  <!-- FORM ROW -->
                  <div class="form-row">
        <h4 style="margin-bottom: 24px;">Select a Digimon to be your first partner</h4>

            <div class="grid-3col_1 no-gutter centered" style="overflow: hidden;">
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Digimons/Koromon__bVvC0qix5.gif?updatedAt=1684420344750" style="width: 33%"></img></div>

                    <div class="radio-item">
                            <input type="radio" id="digimon_selection_koromon" name="select_starter" value="digimon_selection_koromon" checked="checked">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="digimon_selection_koromon" class="rl-label">Koromon</label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                  
                  
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Digimons/Tanemon_rxmdFG5Xn.gif?updatedAt=1684420415628" style="width: 33%"></img></div>

                    <div class="radio-item">
                            <input type="radio" id="digimon_selection_tanemon" name="select_starter" value="digimon_selection_tanemon">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="digimon_selection_tanemon" class="rl-label">Tanemon</label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                  
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size"><img src="https://ik.imagekit.io/projectvoyage/Digimons/Tsunomon_d5Y82RFHf.gif?updatedAt=1684420414299" style="width: 20%"></img></div>

                    <div class="radio-item">
                            <input type="radio" id="digimon_selection_tsunomon" name="select_starter" value="digimon_selection_tsunomon">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="digimon_selection_tsunomon" class="rl-label">Tsunomon</label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                  <!-- /FORM ROW -->
                </div>
                  <label style="margin-top:14px; margin-bottom: -26px; display: none;" id="starter_selection_error" class="rl-label"></label>
                  <!-- FORM ACTIONS -->
                  <div class="form-actions full">
                    <!-- BUTTON -->
                    <button id="register_starter_button" class="button blue">
                      Continue
                      <!-- BUTTON ORNAMENT -->
                      <span class="button-ornament">
                        <!-- ARROW ICON -->
                        <svg class="arrow-icon medium">
                          <use xlink:href="#svg-arrow-medium"></use>
                        </svg>
                        <!-- /ARROW ICON -->

                        <!-- CROSS ICON -->
                        <svg class="cross-icon small">
                          <use xlink:href="#svg-cross-small"></use>
                        </svg>
                        <!-- /CROSS ICON -->
                      </span>
                      <!-- /BUTTON ORNAMENT -->
                    </button>
                    <!-- /BUTTON -->
                  </div>
                  <!-- /FORM ACTIONS -->
                <!-- /FORM WRAP -->
            `
									})

									var RSB = document.getElementById("register_starter_button")
									var SSE = document.getElementById("starter_selection_error")
									var checkList = document.querySelectorAll('[name=select_starter]')

									RSB.addEventListener("click", () => {
                    RSB.classList.add("disabled")
										var starter = 2

										checkList.forEach(checkbox => {
											if (checkbox.checked) {
												if (checkbox.value === "digimon_selection_koromon") starter = 2
												if (checkbox.value === "digimon_selection_tanemon") starter = 6
												if (checkbox.value === "digimon_selection_tsunomon") starter = 3
											}
										})

										fetch('/api/register/starter', {
											method: 'POST',
											headers: {
												'Content-Type': 'application/json',
											},
											body: JSON.stringify({ starter })
										}).then((response) => response = response.json()).then((body) => {
											console.log(body)
											if (!body.success) {
												SSE.style.display = "block"
												SSE.style.color = "#f30a5c"
												SSE.innerHTML = body.error
											} else {
												SSE.style.display = "block"
												SSE.style.color = "#58d819"
												SSE.innerHTML = "Done, Redirecting..."

												window.location = "/me"
											}
										})
                  })
          </script>
        <% } %>
            

</body>

</html>