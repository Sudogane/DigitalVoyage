<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<!-- style -->
	<link rel="stylesheet" href="/css/style.min.css">
	<link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/app.css">
  
  <script src="https://kit.fontawesome.com/d34c5a5f9e.js" crossorigin="anonymous"></script>
	<!-- favicon -->
	<link rel="icon" href="https://cdn.glitch.global/f7f568cf-be3c-4b93-81f8-b9ec4596a310/favicon.ico?v=1664078135563">
	<title>Digital Voyage | Inventory</title>
    
  <meta name="theme-color" content="#30aaff">
  <meta name="description" content="Digital Voyage is a brand-new browser, Join-us and start your brand new Digital Adventure right now, the Digital Universe calls for you, Voyager!">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Digital.Voyage: Season One">
  <meta property="og:title" content="Digital Voyage - A Brand new Virtual Monster Browser-RPG">
  <meta property="og:description" content="🎮 Embark on a thrilling Digital Voyage as a Digital Explorer in our exciting new Browser Game! 🌟 Join-us now to explore the world of Digital Voyage🎲🐾, where you'll encounter Virtual Monsters, Bosses, and Lots of Fun. 🤖🔍 Become a Voyager and start your epic journey today! 🚀💫 Don't miss out on this captivating experience! Play now and embrace the excitement! 🎉🌌 Art By: thatsquirrelly">
  <meta property="og:image" content="https://img3.gelbooru.com//samples/19/ee/sample_19ee0fa08b4a12c8bfc94d594f16690f.jpg">
  <meta name="twitter:card" content="summary_large_image">
</head>

<body>
	<!-- NAVIGATION WRAP -->
	<%- include('../../partials/navbar') %>
	<!-- /NAVIGATION WRAP -->
    
  <!-- OPEN MOBILE MENU WRAPPER -->
  <%- include("../../partials/openMobileMenu")%>
  <!-- OPEN MOBILE MENU WRAPPER -->

    <!-- Mobile User Banner-->
    <%- include("../../partials/tamer/banner")%>
    <!-- Mobile User Banner-->
      
		<!-- LIVE NEWS WIDGET WRAP -->
		<%- include("../../partials/livenews") %>
			<!-- /LIVE NEWS WIDGET WRAP -->

			<!-- LAYOUT CONTENT FULL -->
			<div class="layout-content-1 layout-item-3-1 grid-limit">
				<!-- LAYOUT BODY -->
				<div class="layout-body layout-item layout-item-body">
          
					<!-- WIDGET ITEM -->
					<div class="widget-item">
						<!-- SECTION TITLE WRAP -->
						<div class="section-title-wrap blue">
							<h2 class="section-title medium layout-item-title"><img src="https://ik.imagekit.io/projectvoyage/Interface/Inventory/ui_bag_XQEOwS2Oz.png?updatedAt=1682277867444"> Battle Inventory</h2>
							<div class="section-title-separator"></div>
						</div>
						<!-- /SECTION TITLE WRAP -->
					</div>
					<!-- /WIDGET ITEM -->
          
          <div class="grid-5col_1 centered no-gutter" style="display: flex; justify-content: center; flex-wrap: wrap; gap: 16px;">
            <% for(var i=0; i<4; i++) { %>
              <div id="battle_inventory_item_<%- i %>" class="inventory-item"><i class="fa-solid fa-plus"></i></div>
            <% } %>
          </div>
          
          
					<!-- WIDGET ITEM -->
					<div class="widget-item">
						<!-- SECTION TITLE WRAP -->
						<div class="section-title-wrap blue">
							<h2 class="section-title medium layout-item-title"><img src="https://ik.imagekit.io/projectvoyage/Interface/Inventory/ui_backpack_i2JRHjLIK.png?updatedAt=1682277867444"> Inventory 
                <span style="float: right; margin-top: 2%; margin-right: 16px;"><%- userData.modules.inventory.length %>/<%- userData.modules.capacities.inventory %></span>
              </h2>
							<div class="section-title-separator"></div>
						</div>
						<!-- /SECTION TITLE WRAP -->
					</div>
					<!-- /WIDGET ITEM -->
          <div class="DV-message" style="justify-self: center; width: 50rem;">
            <img
              src="https://ik.imagekit.io/projectvoyage/Digimons/Datamon_nM4idwN--.gif?ik-sdk-version=javascript-1.4.3&updatedAt=1670347687582"
              style="width: 8%; margin-right: 16px; border-radius: 50%;"
            />
            <div style="display: inline-block; vertical-align: middle; width: 40rem;">
              <h4 style="margin-bottom: 4px;">
                 Hello, <%- userData.username%>! Are you interested in increasing your inventory space?
              </h4>
              <p>
                If so, feel free to <a onclick="openUpgradeInventoryModal()" class="text-yellow"><b>click here</b></a> to explore the inventory space expansion options I have available for sale.
            </div>
          </div>
          
          <div class="grid-5col_1 centered no-gutter" style="display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; margin-bottom: 32px;">
            <% for(var i=0; i<userData.modules.capacities.inventory; i++) { %>
              <% const thisItem = userData.modules.inventory[i]%>
              <div id="inventory_item_<%- i %>" class="inventory-item background-rarity-<%- thisItem?.rarity %>">
                <% if(thisItem) { %>
                  <img src=<%- thisItem.icon %> width=80>
                <% } %>
              </div>
            <% } %>
          </div>
          

				</div>
				<!-- /LAYOUT BODY -->

				<!-- LAYOUT SIDEBAR 2 -->
				<div class="layout-sidebar2 layout-item gutter-medium">
          <!-- WIDGET SIDEBAR -->
          <%- include("../../partials/tamer/sidebar/sidebar") %>
					<!-- /WIDGET SIDEBAR -->
				</div>
				<!-- /LAYOUT SIDEBAR 2 -->
			</div>
			<!-- LAYOUT CONTENT FULL -->

			<%- include("../../partials/footer") %>

				<!-- app bundle -->
        <script src="/app.bundle.min.js"></script>
        <%- include("../../functions/main") %>
        
        <script>
          function openUpgradeInventoryModal() {
              swal.fire({
                showConfirmButton: false,
                html: `
                  <div style="height: max-content; padding: 16px;">
                    <img style="width: 100px; margin-top: 4px;" class="floater" src="https://ik.imagekit.io/projectvoyage/Interface/Inventory/ui_backpack_i2JRHjLIK.png?updatedAt=1682277867444"></img>
                    <div class="upgrade-info-container">
                      <p><b class="text-white">Current Capacity:</b> <%- userData.modules.capacities.inventory %></p>
                      <p><b class="text-white">Items Stored:</b> <%- userData.modules.inventory.length %> Items</p>

                      <br>
                      <p><b class="text-white">Upgraded Capacity:</b> <%- userData.modules.capacities.inventory + 15 %>
                      <p><b class="text-white">Upgrade Cost:</b> <%- Math.round(1750 * (userData.modules.capacities.inventory / 4.2) )%> Bits
                    </div>
                    
                    <a style="margin-top: 16px;" onclick="upgradeInventory()" class="button button-normal small blue">Upgrade Inventory</a>
                  </div>
                      `
              })
          }
          
          async function upgradeInventory() {
            try {
              const response = await API.post("/inventory/upgradeInventory", {});
              if (response.data) window.location.reload();
            } catch (error) {
              console.log(`Error while upgrading inventory: ${error}`);
              console.log(error.response);

              if (error.response && error.response.status === 400) {
                Toastify({
                  escapeMarkup: false,
                  text: `<h4>${error.response.data}</h4>`,
                  duration: 3000,
                  close: false,
                  gravity: "top",
                  position: "center",
                  stopOnFocus: false,
                  className: "app-toast failure",
                }).showToast();
              }
            }
          }

        </script>
        
        <script>
          
          <%
            function gerarEstrelas(numero) {
              let estrelas = '';

              for (let i = 0; i < numero; i++) {
                estrelas += '\u2605';
              }

              return estrelas;
            }  
          %>
            
          <% for(var i=0; i<userData.modules.capacities.inventory; i++) { %>
            <% const thisItem = userData.modules.inventory[i]%>
            <% if(thisItem && Object.keys(thisItem).length) {%>
              tippy("#inventory_item_<%- i %>", {
                theme: "maintheme",
                allowHTML: true,
                interactive: true,
                content: `
                  <div>
                    <div style="display: flex; justify-content: center; border-radius: 0 16px 0 0;" class="background-rarity-<%- thisItem.rarity || 4 %>">
                      <img style="width: fit-content; max-width: 142px; max-height: 142px;" src="<%- thisItem.icon %>">
                    </div>

                    <div class="TT-evolution">
                      <div style="margin-bottom: 16px; text-align: center;">
                        <h3><%- thisItem.name %></h3>
                        <span><%- gerarEstrelas(thisItem.rarity || 1) %></span>
                        <p><%- `${thisItem.type.charAt(0).toUpperCase()}${thisItem.type.slice(1, thisItem.type.length)}` %></p>
                      </div>

                      <div style="text-align: center">
                        <h4>Level: <p style="display: inline;"><%- thisItem.level || "Undefined" %></p><h4>
                      </div>

                      <div class="party-modal-stats" style="padding: 4px;">
                        <div style="display: flex; justify-content: center; text-align: center; gap: 8px;">
                          <p><b>Atk:</b> +<%- thisItem.mainStat %></p>
                          <p><b><%- thisItem.subStat%>:</b> +<%- thisItem.statAmountIncrease %></p>
                        </div>
                        <p style="text-align: left; padding: 4px;"><b><%- thisItem.passive.name %>:</b><br><%- thisItem.passive.description %></p>
                      </div>
                      
                      <div style="margin-top: 8px; display: flex; gap: 4px; justify-content: center;">
                        <button onclick="openEquipModal(<%- i %>)" class="button blue small"><i class="fa-solid fa-square-minus"></i> Equip</button>
                      </div>
                  </div>
                `
              })
            <% } %>
          <% } %>
          function openEquipModal(equipmentIndex) {
              swal.fire({
                showConfirmButton: false,
                html: `
        <div class="form-wrap">
                  <!-- FORM ROW -->
                  <div class="form-row">
                  <h4 style="margin-bottom: 24px;">Select a Digimon to Equip this Item</h4>

            <div class="grid-3col_1 no-gutter centered" style="overflow: hidden;">
                <% userData.modules.party.forEach((digimon, i) => { %>
                  <!-- COLUMN -->
                  <div class="column">
                    <div class="col-size" style="height: 100px; display: flex; justify-content: center; align-items: center;">
                      <img style="width: fit-content; max-width: 82px; max-height: 82px;" src=<%- digimon.sprite%> alt="Agumon">                    
                    </div>

                    <div class="radio-item">
                            <input type="radio" id="equip_item_to_<%- i %>" name="equip_item" value="<%= i %>">
                            <!-- RADIO CIRCLE -->
                            <div class="radio-circle"></div>
                            <!-- RADIO CIRCLE -->
                            <label for="equip_item_to_<%- i %>" class="rl-label"><%- digimon.nickname || digimon.species %></label>
                          </div>

                  </div>
                  <!-- /COLUMN -->
                <% }) %>
                  <!-- /FORM ROW -->
                </div>
                  <!-- FORM ACTIONS -->
                  <div class="form-actions full">
                    <!-- BUTTON -->
                    <button onclick="equipItem(${equipmentIndex})" class="button blue">
                      Equip Item
                      <!-- BUTTON ORNAMENT -->
                      <span class="button-ornament">
                        <!-- ARROW ICON -->
                        <svg class="arrow-icon medium">
                          <use xlink:href="#svg-arrow-medium"></use>
                        </svg>
                        <!-- /ARROW ICON -->

                        <!-- CROSS ICON -->
                        <svg class="cross-icon small">
                          <use xlink:href="#svg-cross-small"></use>
                        </svg>
                        <!-- /CROSS ICON -->
                      </span>
                      <!-- /BUTTON ORNAMENT -->
                    </button>
                    <!-- /BUTTON -->
                  </div>
                  <!-- /FORM ACTIONS -->
                <!-- /FORM WRAP -->
                    </div>
                      `
              })
          }
            
          function equipItem(equipmentIndex) {
            const checklist = document.querySelectorAll('[name=equip_item]')
            
            checklist.forEach((checkbox, digimonIndex) => {
              const checked = checkbox.checked
              if(!checked) return
              
              API.post("/inventory/equip", { digimonIndex, equipmentIndex }).then(window.location.reload())
            })
          }
        </script>
</body>
</html>